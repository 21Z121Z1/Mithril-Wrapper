<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" />

    <application
        android:hasCode="true"
        android:label="${appLabel}"
        android:allowBackup="false">

        <activity
            android:name=".PostActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PluginActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Modern discovery: the launcher reads this to enumerate renderers.
             The string is generated by the renderer {} DSL in build.gradle.kts.
             Each env entry declared there also needs a title meta-data, or the
             launcher cannot label the option. -->
        <meta-data
            android:name="fclPlugin_V2"
            android:resource="@string/config" />
        <meta-data
            android:name="mithril_gl_version_title"
            android:resource="@string/mithril_gl_version_title" />
        <meta-data
            android:name="mithril_yflip_title"
            android:resource="@string/mithril_yflip_title" />
        <meta-data
            android:name="mithril_debug_title"
            android:resource="@string/mithril_debug_title" />
        <meta-data
            android:name="mithril_vram_budget_title"
            android:resource="@string/mithril_vram_budget_title" />
        <meta-data
            android:name="mithril_turnip_title"
            android:resource="@string/mithril_turnip_title" />
        <meta-data
            android:name="mithril_vulkan_library_title"
            android:resource="@string/mithril_vulkan_library_title" />

        <!-- Legacy discovery path for FCL / Pojav-style launchers. -->
        <meta-data android:name="fclPlugin" android:value="true" />
        <meta-data android:name="des" android:value="${des}" />
        <meta-data android:name="renderer" android:value="${renderer}" />
        <meta-data android:name="boatEnv" android:value="${boatEnv}" />
        <meta-data android:name="pojavEnv" android:value="${pojavEnv}" />
    </application>

</manifest>
